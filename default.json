{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabled": true,
  "description": "Default Renovate config used by @Kiruyuto",
  "extends": [
    "config:recommended",
    ":gitSignOff",
    ":dependencyDashboard",
    ":disableRateLimiting",
    "helpers:pinGitHubActionDigests",
    "abandonments:recommended",
    "security:minimumReleaseAgeNpm"
  ],
  "constraints": {
    "ghActionsLock": "v0.2.0"
  },
  "labels": [
    "dependencies"
  ],
  "dependencyDashboardLabels": [
    "dependencies"
  ],
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "timezone": "Europe/Warsaw",
  "schedule": [
    "* 0-7 * * 1"
  ],
  "updateNotScheduled": true,
  "ignoreTests": false,
  "rangeStrategy": "bump",
  "pinDigests": false,
  "commitBodyTable": true,
  "configMigration": true,
  "branchPrefix": "deps/",
  "prCreation": "immediate",
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "separateMajorMinor": true,
  "prBodyTemplate": "{{{header}}}{{{table}}}{{{warnings}}}{{{notes}}}{{{changelogs}}}{{{controls}}}{{{footer}}}",
  "dependencyDashboardFooter": "<h6>Renovate extends from Kiruyuto's default configuration. You can see all settings <a href=\"https://github.com/Kiruyuto/renovate-config/blob/master/default.json\">here</a></h6>\n\n- [ ] <!-- manual job -->Check this box to trigger a request for Renovate to run again on this repository",
  "commitMessageLowerCase": "never",
  "semanticCommits": "enabled",
  "semanticCommitScope": "dependencies",
  "rebaseWhen": "behind-base-branch",
  "baseBranchPatterns": [
    "$default"
  ],
  "major": {
    "description": "Require dashboard approval for major updates",
    "automerge": false,
    "dependencyDashboardApproval": true
  },
  "patch": {
    "automerge": true
  },
  "minor": {
    "automerge": true
  },
  "pin": {
    "automerge": true
  },
  "pinDigest": {
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "rebaseWhen": "behind-base-branch"
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "dependencyDashboardApproval": false,
    "rangeStrategy": "update-lockfile",
    "commitMessageSuffix": "[SECURITY]",
    "branchTopic": "{{{datasource}}}-{{{depNameSanitized}}}-vulnerability",
    "prCreation": "immediate",
    "automerge": false,
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "Always use 'chore' for semantic commit type",
      "matchFileNames": [
        "**/*"
      ],
      "semanticCommitType": "chore"
    },
    {
      "description": "Preserve platform versions when updating target frameworks (net8.0-windows8.0 -> net9.0-windows8.0)",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "TargetFramework"
      ],
      "autoReplaceGlobalMatch": false
    },
    {
      "description": "Pin npm packages and Node.js runtime versions",
      "matchDatasources": [
        "npm",
        "node-version"
      ],
      "rangeStrategy": "pin"
    },
    {
      "description": "Preserve npm peer dependency ranges",
      "matchDatasources": [
        "npm"
      ],
      "matchDepTypes": [
        "peerDependencies"
      ],
      "rangeStrategy": "widen"
    },
    {
      "description": "Pin Node.js runtime versions used by setup-node",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "actions/node-versions"
      ],
      "rangeStrategy": "pin"
    },
    {
      "description": "Group npm dependencies",
      "groupName": "npm dependencies",
      "groupSlug": "npm",
      "matchDatasources": [
        "npm"
      ]
    },
    {
      "description": "Group GitHub Actions dependencies, including composite actions",
      "groupName": "GitHub Actions dependencies",
      "groupSlug": "github-actions",
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "description": "Group Docker images outside the .NET family",
      "groupName": "Docker dependencies",
      "groupSlug": "docker",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "!mcr.microsoft.com/dotnet/**"
      ]
    },
    {
      "description": "Group NuGet packages, target frameworks and .NET SDK/runtime versions",
      "groupName": ".NET dependencies",
      "groupSlug": "dotnet",
      "matchDatasources": [
        "dotnet-version",
        "custom.dotnet-channel",
        "nuget"
      ]
    },
    {
      "description": "Include .NET Docker images in the .NET group without adding digest pins",
      "groupName": ".NET dependencies",
      "groupSlug": "dotnet",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mcr.microsoft.com/dotnet/**"
      ]
    },
    {
      "description": "Group pinning updates separately for each category",
      "matchJsonata": [
        "groupName in ['.NET dependencies', 'npm dependencies', 'GitHub Actions dependencies', 'Docker dependencies']"
      ],
      "matchUpdateTypes": [
        "pin",
        "pinDigest"
      ],
      "additionalBranchPrefix": "pins-",
      "group": {
        "branchTopic": "{{{groupSlug}}}",
        "commitMessageTopic": "{{{groupName}}}"
      }
    },
    {
      "description": "Keep digest-only updates in separate manual PRs for each group",
      "matchJsonata": [
        "groupName in ['.NET dependencies', 'npm dependencies', 'GitHub Actions dependencies', 'Docker dependencies']"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "additionalBranchPrefix": "manual-",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Match scalar and multiline .NET SDK versions, including reusable-workflow and custom-action inputs",
      "managerFilePatterns": [
        "/(^|/)(workflow-templates|\\.(?:github|gitea|forgejo)/(?:workflows|actions))/.+\\.ya?ml$/",
        "/(^|/)action\\.ya?ml$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "(?:^|\\r?\\n)[ \\t]*dotnet-version:[ \\t]*(?:[\"']?\\d[^\\r\\n]*|\\|(?:\\+?[ \\t]*(?:#[^\\r\\n]*)?\\r?\\n(?:[ \\t]+\\d[^\\r\\n]*(?:\\r?\\n|$)|[ \\t]*\\r?\\n)+|-[ \\t]*(?:#[^\\r\\n]*)?\\r?\\n(?:[ \\t]+\\d[^\\r\\n]*\\r?\\n(?:[ \\t]*\\r?\\n)*)+[ \\t]+\\d[^\\r\\n]*(?:\\r?\\n|$)))",
        "(?:^|\\r?\\n)[ \\t]*(?:dotnet-version:[ \\t]*[\"']?)?(?<currentValue>\\d[^\\s\"']*)"
      ],
      "depTypeTemplate": "dotnet",
      "datasourceTemplate": "dotnet-version",
      "depNameTemplate": "dotnet-sdk",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Match .nuspec <dependency> tag",
      "managerFilePatterns": [
        "/\\.nuspec$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "<!--[\\s\\S]*?-->|<dependency\\b[^>]*?\\sid\\s*=\\s*[\"'](?<depName>[^\"']+)[\"'][^>]*>",
        "<!--[\\s\\S]*?-->|\\sversion\\s*=\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "nuget",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "description": "Match individual target frameworks in .NET projects and shared build properties",
      "managerFilePatterns": [
        "/(^|/)Directory\\.Build\\.props$/",
        "/\\.(?:cs|fs|vb)proj$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "<!--[\\s\\S]*?-->|<TargetFrameworks?\\b[^>]*>[^<]*</TargetFrameworks?\\s*>",
        "<!--[\\s\\S]*?-->|(?:>|;)[ \\t\\r\\n]*net(?<currentValue>\\d+\\.\\d+)(?:-[0-9A-Za-z.-]+)?"
      ],
      "depNameTemplate": "TargetFramework",
      "datasourceTemplate": "custom.dotnet-channel",
      "versioningTemplate": "loose"
    }
  ],
  "customDatasources": {
    "dotnet-channel": {
      "description": "Channel. Used for <TargetFramework/> updates in .NET project files",
      "defaultRegistryUrlTemplate": "https://dotnetcli.blob.core.windows.net/dotnet/release-metadata/releases-index.json",
      "transformTemplates": [
        "{\"releases\": [`releases-index`[`support-phase` != 'preview' and `support-phase` != 'eol'].{\"version\": `channel-version`}], \"sourceUrl\": \"https://dotnetcli.blob.core.windows.net/dotnet/release-metadata/releases-index.json\", \"homepage\": \"https://github.com/dotnet/sdk\"}"
      ]
    }
  }
}